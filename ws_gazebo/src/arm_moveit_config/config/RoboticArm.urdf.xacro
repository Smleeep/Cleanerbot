<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="RoboticArm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import RoboticArm urdf file -->
    <xacro:include filename="$(find gazebo_simulation)/urdf/RoboticArm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="RoboticArm.ros2_control.xacro" />


    <xacro:RoboticArm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
